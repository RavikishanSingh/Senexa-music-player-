    <style name="Base.Theme.Senexa" parent="Theme.Material3.DayNight.NoActionBar">
        
        
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar">true</item>

        
        <item name="colorPrimary">@color/spotify_green</item>
        <item name="colorPrimaryVariant">@color/spotify_light_green</item>
        <item name="colorOnPrimary">@color/text_light</item>

        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorOnBackground">@color/text_dark</item>

        <item name="colorSurface">#fff</item>
        <item name="colorOnSurface">@color/text_dark</item>

        <item name="colorAccent">@color/spotify_green</item>

        
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>

        
        <item name="android:divider">@color/divider_light</item>

        <item name="android:icon">@mipmap/ic_launcher</item>
        <item name="android:roundIcon" tools:ignore="NewApi">@mipmap/ic_launcher_round</item>

    </style>
    <style name="CustomTheme" parent="Base.Theme.Senexa">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="MYBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="MyBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/MYBottomSheetStyle</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="ShapeAppearanceOverlay.App.CornerSize100Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>
    <style name="Theme.Senexa" parent="Base.Theme.Senexa"/>
    <style name="ToolbarTheme" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="colorControlNormal">@color/textMain</item>
    </style>
    <style name="TransparentText">
        <item name="android:textColor">#00000000</item>
    </style>
    <declare-styleable name="BottomSheetItemView">
        <attr format="string" name="title"/>
        <attr format="reference" name="android:src"/>
        <attr format="dimension|reference" name="srcPadding"/>
    </declare-styleable>
    <declare-styleable name="MaterialCustomSwitch">
        <attr format="string" name="textHead"/>
        <attr format="string" name="textOn"/>
        <attr format="string" name="textOff"/>
        <attr format="boolean" name="checked"/>
    </declare-styleable>
</resources>